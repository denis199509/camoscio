# Copia questo file in ".env" (stesso nome, senza .example) e riempi i valori reali.
# Il file ".env" non viene mai caricato su GitHub (e' escluso in .gitignore).

# Porta su cui parte il server in locale
PORT=3000

# "development" in locale, "production" quando gira su Render (Fase E)
NODE_ENV=development

# Stringa segreta per firmare i cookie di sessione di login (Fase C). Deve essere lunga e casuale.
SESSION_SECRET=sostituisci-con-una-stringa-lunga-e-casuale

# Stringa di connessione MongoDB Atlas, del tipo mongodb+srv://... (arriva nella Fase B, per ora lascia vuoto)
MONGODB_URI=

# --- Recupero password via email (punto 7) --------------------------------------------
# Indirizzo pubblico del sito, usato per costruire i link dentro le email.
# In locale: http://localhost:3000 - su Render: https://camoscio.onrender.com
# NON si ricava dall'intestazione "Host" della richiesta: quella la sceglie chi chiama, e
# permetterebbe di far arrivare a un utente vero un link che punta al server di qualcun altro.
APP_BASE_URL=http://localhost:3000

# Chiave dell'API di Brevo (brevo.com, piano gratuito: 300 email al giorno).
# PERCHE' BREVO E NON SMTP: il piano gratuito di Render blocca le connessioni in uscita
# sulle porte SMTP (25, 465, 587), quindi Gmail/Nodemailer non partirebbero una volta
# online. L'API di Brevo e' una normale chiamata HTTPS e passa.
# SE QUESTA CHIAVE E' VUOTA il sito non si rompe: le email non partono e il loro contenuto
# (link compreso) viene stampato sul terminale del server. E' cosi' che si fanno le prove
# in locale, senza configurare niente.
BREVO_API_KEY=

# Indirizzo del mittente. Deve essere un indirizzo VERIFICATO nel pannello di Brevo,
# altrimenti l'invio viene rifiutato.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Camoscio
