# Copia questo file in ".env" (stesso nome, senza .example) e riempi i valori reali.
# Il file ".env" non viene mai caricato su GitHub (e' escluso in .gitignore).

# Porta su cui parte il server in locale
PORT=3000

# "development" in locale, "production" quando gira su Render (Fase E)
NODE_ENV=development

# Stringa segreta per firmare i cookie di sessione di login (Fase C). Deve essere lunga e casuale.
SESSION_SECRET=sostituisci-con-una-stringa-lunga-e-casuale

# Stringa di connessione MongoDB Atlas, del tipo mongodb+srv://... (arriva nella Fase B, per ora lascia vuoto)
MONGODB_URI=

# --- Recupero password via email (punto 7) --------------------------------------------
# Indirizzo pubblico del sito, usato per costruire i link dentro le email.
# In locale: http://localhost:3000 - su Render: https://camoscio.onrender.com
# NON si ricava dall'intestazione "Host" della richiesta: quella la sceglie chi chiama, e
# permetterebbe di far arrivare a un utente vero un link che punta al server di qualcun altro.
APP_BASE_URL=http://localhost:3000

# Credenziali dell'API di Mailjet (mailjet.com, piano gratuito: 200 email al giorno,
# 6.000 al mese). SONO DUE STRINGHE, non una: si trovano insieme nella stessa pagina del
# pannello, sotto "API Key Management (REST API, SMTP)".
# PERCHE' UN'API HTTP E NON SMTP: dal 26/09/2025 il piano gratuito di Render blocca le
# connessioni in uscita sulle porte SMTP (25, 465, 587), quindi Gmail/Nodemailer non
# partirebbero una volta online. L'API di Mailjet e' una normale chiamata HTTPS e passa.
# PERCHE' MAILJET E NON BREVO: Brevo chiede la partita IVA per iscriversi.
# SE SONO VUOTE il sito non si rompe: le email non partono, il loro contenuto (link
# compreso) viene stampato sul terminale del server, e a schermo si legge che il recupero
# non e' ancora attivo. E' cosi' che si fanno le prove in locale, senza configurare niente.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Indirizzo del mittente. Deve essere VERIFICATO nel pannello del servizio
# ("Sender domains & addresses"), altrimenti l'invio viene rifiutato - e Mailjet lo
# rifiuta rispondendo comunque 200, quindi l'errore si vede solo nel log del server.
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Camoscio

# --- Dead Man's Switch lato server (punto 37) -----------------------------------------
# Stringa segreta a scelta, che protegge POST /api/safety/controlla-scadenze - la rotta che
# un trigger ESTERNO (questo progetto non ha nessuno scheduler) chiama ogni tot minuti per
# vedere se qualche timer e' scaduto e mandare l'allarme vero. Senza, chiunque su internet
# potrebbe chiamarla a ripetizione. Chi chiama la rotta deve mandare lo stesso valore, come
# query string (?chiave=...) o header (X-Safety-Cron-Secret).
# SE VUOTA in locale (NODE_ENV=development) la rotta resta aperta, per poterla provare a mano
# senza configurare niente. IN PRODUZIONE se vuota la rotta rifiuta sempre (fail-closed).
SAFETY_CRON_SECRET=

# --- Eliminazione account: scrub a fine grazia (punto A-3.4) -------------------------
# Stessa identica idea di SAFETY_CRON_SECRET, per una rotta diversa: protegge
# POST/GET /api/users/scrub-eliminati, che un trigger ESTERNO (cron-job.org, un colpo al
# giorno) chiama per cancellare i dati personali degli account la cui grazia di 30 giorni
# e' scaduta. Chi chiama manda lo stesso valore come ?chiave=... o header X-Cron-Secret.
# SE VUOTA: in locale la rotta resta aperta (prova a mano), in produzione rifiuta sempre.
# SE NON CONFIGURATA su Render: gli account eliminati restano "Account eliminato" a tempo
# indeterminato (nessuno scrub) - fail-safe, ma il job va impostato.
# Deve essere DIVERSA da SAFETY_CRON_SECRET (due job indipendenti).
ACCOUNT_SCRUB_SECRET=
