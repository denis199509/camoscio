# Dipendenze
node_modules/

# Segreti e configurazione locale (mai su GitHub)
.env

# Database locale: dalla Fase B in poi non e' piu' il database reale (si passa a MongoDB Atlas)
data/db.json

# Contenuti caricati dagli utenti (note vocali ecc.), rigenerati automaticamente all'avvio del server
public/uploads/*

# File di sistema Windows
Thumbs.db

# Progresso dell'estrazione dei sentieri (punto 13): file di lavoro, si rigenera
data/estrazione-progresso.json

# Prodotti delle prove automatiche (cartella prove/): si rigenerano ad ogni esecuzione.
# Gli SCRIPT invece si salvano, sono loro il lavoro.
prove/*.log
prove/*.png
